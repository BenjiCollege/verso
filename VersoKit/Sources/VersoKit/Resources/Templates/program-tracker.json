{
  "kind": "template",
  "id": "program-tracker",
  "name": "Program Tracker",
  "summary": "Weeks of a training block, with working maxes and how far through you are.",
  "systemImage": "calendar.badge.clock",
  "category": "fitness",
  "titleFormat": "Training block — {date}",
  "blocks": [
    { "type": "heading", "payload": { "level": 1, "text": "Training block" } },
    { "type": "progress", "payload": { "label": "Weeks completed", "current": 0, "target": 12, "style": "bar" } },
    { "type": "divider", "payload": { "style": "rule" } },
    { "type": "heading", "payload": { "level": 2, "text": "Working maxes" } },
    { "type": "metric", "payload": { "label": "Back Squat", "seriesID": "back-squat-max", "unit": "kg", "catalogID": "exercises", "showsPreviousEntry": true, "decomposition": { "base": 20, "units": [25, 20, 15, 10, 5, 2.5, 1.25], "paired": true, "unit": "kg" } } },
    { "type": "metric", "payload": { "label": "Bench Press", "seriesID": "bench-press-max", "unit": "kg", "catalogID": "exercises", "showsPreviousEntry": true, "decomposition": { "base": 20, "units": [25, 20, 15, 10, 5, 2.5, 1.25], "paired": true, "unit": "kg" } } },
    { "type": "metric", "payload": { "label": "Deadlift", "seriesID": "deadlift-max", "unit": "kg", "catalogID": "exercises", "showsPreviousEntry": true, "decomposition": { "base": 20, "units": [25, 20, 15, 10, 5, 2.5, 1.25], "paired": true, "unit": "kg" } } },
    { "type": "divider", "payload": { "style": "rule" } },
    { "type": "heading", "payload": { "level": 2, "text": "Weeks" } },
    {
      "type": "table",
      "payload": {
        "caption": "Plan",
        "columns": [
          { "title": "Week", "kind": "number" },
          { "title": "Focus", "kind": "text" },
          { "title": "Sessions", "kind": "number" },
          { "title": "Done", "kind": "checkbox" }
        ],
        "rows": [
          { "cells": [{ "number": 1 }, {}, { "number": 4 }, {}] },
          { "cells": [{ "number": 2 }, {}, { "number": 4 }, {}] },
          { "cells": [{ "number": 3 }, {}, { "number": 4 }, {}] },
          { "cells": [{ "number": 4 }, { "text": "Deload" }, { "number": 3 }, {}] }
        ]
      }
    },
    { "type": "formula", "payload": { "label": "Sessions planned", "expression": "sum(column(\"Sessions\"))" } }
  ]
}
