{
  "kind": "template",
  "id": "hydration",
  "name": "Hydration",
  "summary": "Glasses through the day, against a target.",
  "systemImage": "drop",
  "category": "fitness",
  "titleFormat": "Water — {date}",
  "blocks": [
    { "type": "progress", "payload": { "label": "Glasses", "current": 0, "target": 8, "style": "dots" } },
    { "type": "metric", "payload": { "label": "Water", "seriesID": "water", "unit": "ml", "target": 2000, "showsPreviousEntry": true } },
    { "type": "formula", "payload": { "label": "Average this quarter", "expression": "avg(series(\"water\"))" } },
    { "type": "schedule", "payload": { "label": "Drink some water", "recurrence": { "frequency": "daily" }, "alarms": [{ "offset": 0 }] } },
    { "type": "text", "payload": { "plain": "" } }
  ]
}
