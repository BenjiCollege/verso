{
  "kind": "template",
  "id": "grocery-run",
  "name": "Grocery Run",
  "summary": "Aisle-grouped list with a running total and a store reminder.",
  "systemImage": "cart",
  "category": "shopping",
  "stockID": "ruled",
  "titleFormat": "Grocery Run — {date}",
  "blocks": [
    {
      "type": "place",
      "payload": { "name": "Any grocery store", "poiCategory": "MKPOICategoryFoodMarket", "radius": 200, "trigger": "arrive" }
    },
    {
      "type": "checklist",
      "payload": {
        "groupBy": "group",
        "itemFields": ["quantity", "unit", "price", "note"],
        "groups": [
          { "id": "produce", "label": "Produce", "position": 0 },
          { "id": "bakery", "label": "Bakery", "position": 1 },
          { "id": "dairy", "label": "Dairy & Eggs", "position": 2 },
          { "id": "meat", "label": "Meat & Fish", "position": 3 },
          { "id": "pantry", "label": "Pantry", "position": 4 },
          { "id": "frozen", "label": "Frozen", "position": 5 },
          { "id": "household", "label": "Household", "position": 6 }
        ],
        "items": []
      }
    },
    { "type": "divider", "payload": { "style": "rule" } },
    { "type": "formula", "payload": { "label": "Basket total", "expression": "sum(subtotal)" } },
    { "type": "formula", "payload": { "label": "In the trolley", "expression": "sum(checkedSubtotal)" } },
    { "type": "formula", "payload": { "label": "Still to find", "expression": "uncheckedCount" } }
  ]
}
